# local-only reference material, never pushed
/context/
context/

# raw and derived data (large, external)
/data/interim/
/data/processed/
data/interim/
data/processed/

# artifacts (models, indices, evidence logs can be large/binary)
artifacts/models/*
artifacts/indices/*
artifacts/*.duckdb
artifacts/*.duckdb.wal
!artifacts/models/.gitkeep
!artifacts/indices/.gitkeep
# checksums/sizes/source_urls only, never the binaries - see artifacts.py
!artifacts/models/manifest.json

# reports output
reports/figures/*
reports/metrics/*
reports/pdf/*
!reports/figures/.gitkeep
!reports/metrics/.gitkeep
!reports/pdf/.gitkeep
# Small aggregate metrics (no raw data, no paths) - needed by the deployed
# frontend's /api/models/evaluation route, which has no Blob-fetch fallback
# the way model artifacts do. See frontend/package.json's prebuild step.
!reports/metrics/rul_evaluation.json

# local config with private paths
config/data_paths.toml

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# review deliverables - large binaries and study material are intentionally
# local only (docs/decisions.md D20 item 8); the generated status doc stays
# tracked
deliverables/review/*
!deliverables/review/REVIEW2_STATUS.md

# local run logs
logs/

# local-only session handoff notes - never pushed
AGENT_HANDOFF.md

.vercel
.env*

# nightshift Phase V compute cache (content-addressed, regenerable)
.cache/
