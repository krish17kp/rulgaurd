  "info": {
    "description": "Read-only inference over cached bearing_pdm artifacts. Never fits a model.",
    "title": "RULGuard prediction service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/analyze/features": {
      "post": {
        "description": "Upload -> dataset detection -> validation -> preprocessing -> feature\nextraction, with a `stages` array on success and on every staged failure\n(docs/feature-analysis.md). The raw upload lives only in a temporary file\nremoved when the request ends.",
        "operationId": "analyze_features_analyze_features_post",
        "parameters": [
          {
            "description": "Vibration header column (or its canonical name).",
            "in": "query",
            "name": "channel",
            "required": true,
            "schema": {
              "description": "Vibration header column (or its canonical name).",
              "maxLength": 200,
              "minLength": 1,
              "title": "Channel",
              "type": "string"
            }
          },
          {
            "description": "Required unless regular timestamps in seconds determine it.",
            "in": "query",
            "name": "sampling_rate_hz",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "maximum": 1000000.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Required unless regular timestamps in seconds determine it.",
              "title": "Sampling Rate Hz"
            }
          },
          {
            "in": "query",
            "name": "window_samples",
            "required": false,
            "schema": {
              "default": 2560,
              "maximum": 1048576,
              "minimum": 2,
              "title": "Window Samples",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "overlap_samples",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 1048576,
              "minimum": 0,
              "title": "Overlap Samples",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_features_analyze_features_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeFeaturesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyze Features"
      }
    },
    "/analyze/rul": {
      "post": {
        "description": "Ordered FEMTO acquisitions (two named axes, g) to the latest RUL.\n\nDataset/units are caller attestations, never inferred from signal shape.\nReuse the staged feature pipeline for each axis and public prediction paths;\nnever fit, fill a missing feature, or predict from a truncated run.",
        "operationId": "analyze_rul_analyze_rul_post",
        "parameters": [
          {
            "in": "query",
            "name": "dataset_id",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Dataset Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "units",
            "required": true,
            "schema": {
              "maxLength": 40,
              "minLength": 1,
              "title": "Units",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "preprocessing_version",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Preprocessing Version",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sampling_rate_hz",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "maximum": 1000000.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sampling Rate Hz"
            }
          },
          {
