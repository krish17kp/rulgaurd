# Normalize text files to LF so a CRLF worktree (e.g. after a Windows checkout)
# never shows spurious modifications against the LF blobs actually committed.
* text=auto eol=lf

*.csv filter=lfs diff=lfs merge=lfs -text
# Tiny committed test fixtures (a few hundred KB) stay as plain text, not LFS -
# they need to be readable without an LFS pull for tests/docs to work standalone.
data/fixtures/**/*.csv -filter -diff -merge -text
datasets/femto/*.zip filter=lfs diff=lfs merge=lfs -text
