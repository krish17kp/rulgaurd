FROM node:22-bookworm-slim AS build
WORKDIR /repo
COPY src ./src
COPY artifacts/rag_index ./artifacts/rag_index
COPY frontend ./frontend
WORKDIR /repo/frontend
ARG NEXT_PUBLIC_API_BASE_URL=/api
ARG NEXT_PUBLIC_DIRECT_UPLOAD_THRESHOLD_BYTES=67108864
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_DIRECT_UPLOAD_THRESHOLD_BYTES=$NEXT_PUBLIC_DIRECT_UPLOAD_THRESHOLD_BYTES \
    NEXT_TELEMETRY_DISABLED=1
RUN npm ci && npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /repo/frontend ./
USER node
CMD ["npx", "next", "start", "-p", "3000", "-H", "0.0.0.0"]
