# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# auto-generated at build time by the "prebuild" script (package.json) -
# a fresh copy of ../src/bearing_pdm, vendored here so the Vercel Python
# function has it within its rootDirectory-scoped bundle. Never hand-edit
# or commit this; the canonical source is ../src/bearing_pdm.
/api/bearing_pdm/

# same prebuild step, same reason: a copy of ../reports/metrics/rul_evaluation.json
# vendored so METRICS_DIR (REPO_ROOT/reports/metrics, REPO_ROOT resolving to
# this frontend/ directory inside the deployed function) can find it.
/reports/

# same prebuild step: a copy of the already-committed, already-public FEMTO
# test fixture (data/fixtures/femto/Bearing1_1/acc_00001.csv, 78KB) for the
# upload page's "Try sample data" button. Never a full/private dataset.
/public/sample-data/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
