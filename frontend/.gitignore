# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# auto-generated at build time by the "prebuild" script (package.json) -
# a fresh copy of ../src/bearing_pdm, vendored here so the Vercel Python
# function has it within its rootDirectory-scoped bundle. Never hand-edit
# or commit this; the canonical source is ../src/bearing_pdm.
/api/bearing_pdm/

# same reason as /api/bearing_pdm/ above: a fresh copy of
# reports/metrics/rul_evaluation.json, vendored by "prebuild" so the
# Reliability endpoint works in a real Vercel deployment (a sibling
# frontend/reports/ copy is not bundled into the function). Never
# hand-edit or commit this; the canonical source is reports/metrics/
# (tracked, committed directly under frontend/).
/api/reports/

# same reason again: a fresh copy of ../artifacts/rag_index/index.json,
# vendored by "prebuild" so /explain's RAG retrieval works in a real Vercel
# deployment. Never hand-edit or commit this; the canonical source is
# ../artifacts/rag_index/ (tracked, committed directly at the repo root).
/api/rag_index/

# same reason again: a fresh copy of ../deploy_data/*.json, vendored by
# "prebuild" so /trajectory and /models/* routes work in a real Vercel
# deployment. Never hand-edit or commit this; the canonical source is
# ../deploy_data/ (tracked, committed directly at the repo root).
/api/deploy_data/

# local uv environment/lockfile for api/ - requirements.txt is the only
# dependency manifest Vercel's Python builder should see. A stray
# pyproject.toml/uv.lock here makes Vercel prefer the uv/pyproject builder,
# which resolves against this machine's Python 3.14 with no prebuilt wheels
# for numpy/scipy/scikit-learn and bloats the function past the 225MB limit.
/api/pyproject.toml
/api/uv.lock
/api/.python-version
/_uv/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
