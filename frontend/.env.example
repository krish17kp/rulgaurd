NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Required for direct-to-storage uploads (frontend/src/app/blob-upload/route.ts).
# Vercel sets this automatically once a Blob store is connected to the project;
# for local dev, get it from `vercel env pull` or the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=
# Pins the upload-token route and the backend's blob validation to THIS
# project's own Blob store (its hostname, e.g. abc123.public.blob.vercel-storage.com) -
# without it, any *.blob.vercel-storage.com object (any Vercel customer's store)
# is accepted, which an independent review flagged. Set this once a store is connected.
BLOB_STORE_HOSTNAME=
# Same allowlist the backend's CORS policy uses (src/bearing_pdm/api.py's
# ALLOWED_ORIGINS) - the blob-upload route checks it too, as a lightweight
# deterrent against other sites minting upload tokens against this project's
# Blob quota (this project has no auth system - see security.md).
ALLOWED_ORIGINS=http://localhost:3000
